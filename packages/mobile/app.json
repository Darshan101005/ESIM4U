{
  "expo": {
    "name": "ESIM4U",
    "slug": "esim4u-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "esim4u",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "primaryColor": "#FF561E",
    "android": {
      "package": "uk.esim4u.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF561E"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "backgroundColor": "#FF561E",
      "barStyle": "light-content",
      "translucent": false
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/08f80ce5-8674-4ac6-8894-2ea75ac013ee"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF561E",
          "image": "./assets/splash.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08f80ce5-8674-4ac6-8894-2ea75ac013ee"
      }
    },
    "owner": "esim4u",
    "ios": {}
  }
}
