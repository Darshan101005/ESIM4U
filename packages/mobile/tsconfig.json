{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@/app": [
        "./app"
      ],
      "@/components": [
        "./components"
      ],
      "@/screens": [
        "./screens"
      ],
      "@/services": [
        "./services"
      ],
      "@/types": [
        "./types"
      ],
      "@/constants": [
        "./constants"
      ],
      "@/utils": [
        "./utils"
      ],
      "@/hooks": [
        "./hooks"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
